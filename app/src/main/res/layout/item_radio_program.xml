<?xml version="1.0" encoding="utf-8"?>
<!-- 电台节目条目 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- 节目封面 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="节目封面"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_person" />
    </androidx.cardview.widget.CardView>

    <!-- 节目信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/cv_cover"
        app:layout_constraintEnd_toStartOf="@id/iv_play"
        app:layout_constraintTop_toTopOf="@id/cv_cover"
        app:layout_constraintBottom_toBottomOf="@id/cv_cover">

        <!-- 节目名称 -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            tools:text="深夜音乐故事" />

        <!-- 电台名称 + 主播 -->
        <TextView
            android:id="@+id/tv_radio_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#666666"
            android:textSize="13sp"
            tools:text="DJ 陈末 · 网易云音乐电台" />

        <!-- 播放次数 -->
        <TextView
            android:id="@+id/tv_listen_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#999999"
            android:textSize="11sp"
            tools:text="播放 128.5万" />
    </LinearLayout>

    <!-- 播放按钮 -->
    <ImageView
        android:id="@+id/iv_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="播放"
        android:padding="6dp"
        android:src="@drawable/ic_play_arrow"
        android:tint="@color/red_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
