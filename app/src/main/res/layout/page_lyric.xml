<?xml version="1.0" encoding="utf-8"?>
<!--
    歌词页布局
    - 透明背景，与播放页 #1A1A2E 深色背景融合
    - RecyclerView 实现歌词列表，支持居中高亮滚动
    - 顶部/底部渐变遮罩实现边缘淡出效果

    布局说明：
    - RecyclerView 的 paddingTop/paddingBottom 设为 RecyclerView 高度的一半，
      这样第一行和最后一行歌词也能滚动到屏幕中间，实现完整的居中体验。
      这个值在代码中动态设置（通过 post 获取实际高度后计算）。
    - 渐变遮罩覆盖在 RecyclerView 上方，通过 elevation 确保层级正确。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!--
        RecyclerView 歌词列表
        - clipToPadding="false" 允许歌词滚动到 padding 区域
        - paddingTop/paddingBottom 动态设为半屏高度，使首尾歌词也能居中
        - 高亮行通过 scrollToPositionWithOffset 居中显示
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_lyric"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingTop="80dp"
        android:paddingBottom="80dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        顶部渐变遮罩（80dp 高）
        - 从 #1A1A2E 渐变到透明，产生歌词从上方淡入的效果
    -->
    <View
        android:id="@+id/mask_top"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/gradient_fade_top"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        底部渐变遮罩（80dp 高）
        - 从透明渐变到 #1A1A2E，产生歌词向下方淡出的效果
    -->
    <View
        android:id="@+id/mask_bottom"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/gradient_fade_bottom"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
