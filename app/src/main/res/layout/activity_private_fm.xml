<?xml version="1.0" encoding="utf-8"?>
<!--
    私人 FM 页面布局
    深色主题，唱片居中旋转，底部控制按钮
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <!-- 返回按钮 -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="48dp"
        android:contentDescription="返回"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- FM 标题 -->
    <TextView
        android:id="@+id/tv_fm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="私人FM"
        android:textColor="#FF6B6B"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        app:layout_constraintStart_toEndOf="@id/iv_back"
        app:layout_constraintTop_toTopOf="@id/iv_back" />

    <!-- 唱片背景圆环 -->
    <ImageView
        android:id="@+id/iv_disc_bg"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="24dp"
        android:alpha="0.3"
        android:src="@drawable/ic_default_album"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_back" />

    <!-- 唱片封面 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_album"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:cardCornerRadius="110dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_disc_bg"
        app:layout_constraintEnd_toEndOf="@id/iv_disc_bg"
        app:layout_constraintStart_toStartOf="@id/iv_disc_bg"
        app:layout_constraintTop_toTopOf="@id/iv_disc_bg">

        <ImageView
            android:id="@+id/iv_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_album" />
    </androidx.cardview.widget.CardView>

    <!-- 歌曲标题 -->
    <TextView
        android:id="@+id/tv_song_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_disc_bg"
        tools:text="歌曲名称" />

    <!-- 歌手名称 -->
    <TextView
        android:id="@+id/tv_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#999999"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_song_title"
        tools:text="歌手名称" />

    <!-- 歌词区域 -->
    <ScrollView
        android:id="@+id/sv_lyrics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:fadeScrollbars="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_artist"
        app:layout_constraintBottom_toTopOf="@id/sb_progress"
        app:layout_constraintVertical_bias="0">

        <TextView
            android:id="@+id/tv_lyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="#888888"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="歌词加载中..."
            tools:visibility="visible" />
    </ScrollView>

    <!-- 进度条 -->
    <SeekBar
        android:id="@+id/sb_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:thumb="@drawable/ic_lock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sv_lyrics" />

    <!-- 时间标签 -->
    <TextView
        android:id="@+id/tv_current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="00:00"
        android:textColor="#777777"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sb_progress" />

    <TextView
        android:id="@+id/tv_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:text="00:00"
        android:textColor="#777777"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sb_progress" />

    <!-- 控制按钮区域 -->
    <LinearLayout
        android:id="@+id/ll_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_current_time">

        <!-- 不喜欢 / 垃圾桶 -->
        <ImageView
            android:id="@+id/iv_trash"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="跳过"
            android:padding="12dp"
            android:src="@drawable/ic_mode_shuffle"
            android:tint="#888888" />

        <!-- 播放/暂停 -->
        <ImageView
            android:id="@+id/iv_play_pause"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:contentDescription="播放/暂停"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF" />

        <!-- 喜欢 / 红心 -->
        <ImageView
            android:id="@+id/iv_like"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="喜欢"
            android:padding="12dp"
            android:src="@drawable/ic_heart_outline"
            android:tint="#FF6B6B" />
    </LinearLayout>

    <!-- 底部提示 -->
    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        android:alpha="0.5"
        android:gravity="center"
        android:text="根据你的口味推荐，越听越懂你"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
