<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_badge_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="28sp"
            tools:text="🎵" />

        <TextView
            android:id="@+id/tv_badge_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="音乐学徒" />

        <TextView
            android:id="@+id/tv_badge_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#999999"
            android:textSize="12sp"
            android:gravity="center"
            tools:text="等级达到 Lv.5" />

        <!-- 未解锁时显示锁定图标 -->
        <ImageView
            android:id="@+id/iv_locked"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="未解锁"
            android:visibility="gone"
            app:tint="#CCCCCC"
            tools:visibility="visible" />

        <!-- 已解锁标签 -->
        <TextView
            android:id="@+id/tv_unlocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="已获得"
            android:textColor="#8B6914"
            android:textSize="11sp"
            android:background="@drawable/bg_badge_item"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
