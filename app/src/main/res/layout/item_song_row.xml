<?xml version="1.0" encoding="utf-8"?>
<!--
    首页"最新音乐"列表项布局
    优化要点：
    - 封面使用 fitCenter（而非 centerCrop），避免裁剪导致图片信息丢失
    - 封面设置圆角 outlineProvider，ClipToOutline 实现圆角裁剪
    - 默认背景色 #F0F0F0 作为加载前的底色，与占位图风格统一
    - 文本颜色适配 Material 主题，支持深色模式自动切换
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- 序号 -->
    <TextView
        android:id="@+id/tv_index"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="#999999"
        android:textSize="14sp"
        android:gravity="center"
        android:textStyle="bold"
        tools:text="01" />

    <!--
        专辑封面
        - 使用 fitCenter：等比缩放图片完整显示在 48dp 方框内，不裁剪
        - clipToOutline + background 实现圆角：ViewOutlineProvider 提供圆角轮廓
        - 移除旧的 centerCrop，避免封面人物/文字被切掉
    -->
    <ImageView
        android:id="@+id/iv_album_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:scaleType="fitCenter"
        android:background="@drawable/ic_default_album"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:contentDescription="专辑封面"
        tools:src="@drawable/ic_default_album" />

    <!-- 歌曲信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_song_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:textColorPrimary"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="歌曲名称" />

        <TextView
            android:id="@+id/tv_artist_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="歌手名称" />

    </LinearLayout>

    <!-- 收藏按钮 -->
    <ImageView
        android:id="@+id/iv_favorite"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_heart_outline"
        android:padding="3dp"
        android:contentDescription="收藏" />

    <!-- 右侧播放图标 -->
    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="#CCCCCC"
        android:alpha="0.7"
        android:contentDescription="播放" />

</LinearLayout>
