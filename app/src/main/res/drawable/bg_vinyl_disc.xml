<?xml version="1.0" encoding="utf-8"?>
<!-- 唱片底纹：深色圆形背景 + 同心圆环纹理模拟黑胶唱片 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底盘 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
            <stroke
                android:width="2dp"
                android:color="#333333" />
        </shape>
    </item>

    <!-- 内圈凹槽 1 -->
    <item
        android:bottom="30dp"
        android:left="30dp"
        android:right="30dp"
        android:top="30dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#444444"
                android:dashWidth="3dp"
                android:dashGap="4dp" />
        </shape>
    </item>

    <!-- 内圈凹槽 2 -->
    <item
        android:bottom="60dp"
        android:left="60dp"
        android:right="60dp"
        android:top="60dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#3A3A3A"
                android:dashWidth="2dp"
                android:dashGap="5dp" />
        </shape>
    </item>

    <!-- 内圈凹槽 3 -->
    <item
        android:bottom="90dp"
        android:left="90dp"
        android:right="90dp"
        android:top="90dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#555555" />
        </shape>
    </item>

    <!-- 中心圆孔 -->
    <item
        android:bottom="105dp"
        android:left="105dp"
        android:right="105dp"
        android:top="105dp">
        <shape android:shape="oval">
            <solid android:color="#EC4141" />
        </shape>
    </item>
</layer-list>
