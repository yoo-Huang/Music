<?xml version="1.0" encoding="utf-8"?>
<!-- 黑胶唱片纹理：黑色底盘 + 密集同心圆环，放大版用于全屏播放器 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底盘 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
            <stroke android:width="1dp" android:color="#2A2A2A" />
        </shape>
    </item>

    <!-- 外环纹理 -->
    <item android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2E2E2E" android:dashWidth="2dp" android:dashGap="3dp" />
        </shape>
    </item>

    <item android:bottom="16dp" android:left="16dp" android:right="16dp" android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#333333" android:dashWidth="3dp" android:dashGap="4dp" />
        </shape>
    </item>

    <item android:bottom="30dp" android:left="30dp" android:right="30dp" android:top="30dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#383838" android:dashWidth="2dp" android:dashGap="5dp" />
        </shape>
    </item>

    <item android:bottom="48dp" android:left="48dp" android:right="48dp" android:top="48dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#3E3E3E" android:dashWidth="3dp" android:dashGap="4dp" />
        </shape>
    </item>

    <item android:bottom="68dp" android:left="68dp" android:right="68dp" android:top="68dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#444444" android:dashWidth="2dp" android:dashGap="6dp" />
        </shape>
    </item>

    <item android:bottom="90dp" android:left="90dp" android:right="90dp" android:top="90dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#4A4A4A" />
        </shape>
    </item>

    <!-- 中心标签区域 -->
    <item android:bottom="100dp" android:left="100dp" android:right="100dp" android:top="100dp">
        <shape android:shape="oval">
            <solid android:color="#222222" />
            <stroke android:width="1dp" android:color="#555555" />
        </shape>
    </item>

    <!-- 轴心孔 -->
    <item android:bottom="118dp" android:left="118dp" android:right="118dp" android:top="118dp">
        <shape android:shape="oval">
            <solid android:color="#111111" />
            <stroke android:width="1dp" android:color="#666666" />
        </shape>
    </item>
</layer-list>
